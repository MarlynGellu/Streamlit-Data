    "def clean_json_response(text):\n",
    "    \"\"\"Strips markdown code blocks if the model ignores the system prompt.\"\"\"\n",
    "    text = text.strip()\n",
    "    if text.startswith(\"```json\"):\n",
    "        text = text[7:]\n",
    "    if text.startswith(\"```\"):\n",
    "        text = text[3:]\n",
    "    if text.endswith(\"```\"):\n",
    "        text = text[:-3]\n",
    "    return text.strip()"
